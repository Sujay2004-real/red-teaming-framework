# Backend configuration. Copy to backend/.env and edit as needed; every
# value below is optional and shown with its built-in default.

# Where the SQLite database lives. The data/ directory is a named docker volume,
# so the database survives a container rebuild.
DATABASE_URL=sqlite:///./data/redteam.db

# Master key for encrypting provider credentials at rest. Leave blank and the
# backend generates data/.secret_key on first start. Set it explicitly if the
# data directory is not persistent, or the stored credentials become
# undecryptable when the key is regenerated.
REDTEAM_SECRET_KEY=

# The operator API key required by every route except /health. Leave blank and
# the backend generates one on first start, prints it to the console ONCE, and
# stores only its SHA-256 digest. Set it explicitly for Docker deployments,
# CI, and the scripted flows (smoke_e2e.py / eval_harness.py read the same
# variable) - and as the recovery path if a generated key was not written down.
REDTEAM_API_KEY=

# Comma-separated browser origins allowed to call this API. Both localhost
# spellings are allowed by default because port-forward links and terminals
# routinely hand out 127.0.0.1 instead.
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Provider credentials are deliberately NOT read from the environment. The AI
# provider API key, endpoint, model, and proxy are configured from the Settings
# screen and stored encrypted; see test_secret_store.py, which asserts that no
# environment variable can seed a credential.
