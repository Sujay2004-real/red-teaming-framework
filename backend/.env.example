# Backend configuration. Development Compose reads backend/.env when present.
# Native Uvicorn does not load this file automatically: export these variables
# in the launching shell. See docs/deployment.md for production configuration.

# Where the SQLite database lives. The data/ directory is a named docker volume,
# so the database survives a container rebuild.
DATABASE_URL=sqlite:///./data/redteam.db

# Master key for provider/SSH secrets, loot and original evidence. Leave blank and the
# backend generates data/.secret_key on first start. Set it explicitly if the
# data directory is not persistent. Preserve the existing key when upgrading:
# a replacement key cannot decrypt existing data. API and workers need the same
# key. Production Compose uses the shared key file unless explicitly configured.
REDTEAM_SECRET_KEY=

# Application routes require this operator key except /health and /ready.
# FastAPI /docs, /redoc and /openapi.json are also public. Leave blank and
# the backend generates one on first start, prints it to the console ONCE, and
# stores only its SHA-256 digest. Set it explicitly for Docker deployments,
# CI, and as the recovery path if a generated key was not written down.
REDTEAM_API_KEY=

# Comma-separated browser origins allowed to call this API. Both localhost
# spellings are allowed by default because port-forward links and terminals
# routinely hand out 127.0.0.1 instead.
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Provider credentials are deliberately NOT read from the environment. The AI
# provider API key, endpoint, model, and proxy are configured from the Settings
# screen. Secret fields are encrypted; endpoint/model metadata is not.
# See test_secret_store.py for the no-environment-credential-seeding contract.
